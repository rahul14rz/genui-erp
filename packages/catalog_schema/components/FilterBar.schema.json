{
  "title": "FilterBar",
  "description": "Filters the user can change without asking again. Applying them re-runs the bound tool on the server.",
  "x-permission": null,
  "type": "object",
  "properties": {
    "result": { "type": "string", "description": "The tool result id the filters apply to, such as r1." },
    "filters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string", "maxLength": 24 },
          "kind": { "enum": ["dateRange", "select", "text", "toggle"] },
          "options": { "type": "array", "items": { "type": "string" }, "maxItems": 12 },
          "value": { "type": ["string", "boolean", "null"] }
        },
        "required": ["key", "label", "kind"],
        "additionalProperties": false
      }
    }
  },
  "required": ["result", "filters"],
  "additionalProperties": false
}
