{
  "title": "TrendChart",
  "description": "A line or bar chart over time with one or two series read from the same rows.",
  "x-permission": "sales:read",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "kind": { "enum": ["line", "bar"] },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/Row" }, "x-bindable": true },
    "xField": { "type": "string", "x-field": true },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "x-field": true },
          "label": { "type": "string", "maxLength": 32 },
          "format": { "$ref": "#/$defs/Format" }
        },
        "required": ["field", "label", "format"],
        "additionalProperties": false
      }
    }
  },
  "required": ["kind", "rows", "xField", "series"],
  "additionalProperties": false
}
