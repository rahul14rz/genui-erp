{
  "title": "KpiStrip",
  "description": "Two to four headline numbers, each with an optional previous-period value for the delta.",
  "x-permission": null,
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "maxLength": 40 },
          "value": { "type": "number", "x-bindable": true },
          "previous": { "type": "number", "x-bindable": true },
          "format": { "$ref": "#/$defs/Format" }
        },
        "required": ["label", "value", "format"],
        "additionalProperties": false
      }
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
